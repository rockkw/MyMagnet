# /etc/magnetlookup/env
#
# EnvironmentFile consumed by the systemd units. These map directly onto
# the ${VAR:-default} expansions already built into config.ini, so no code
# changes are needed to run in this layout.
#
# Copy this file to /etc/magnetlookup/env and fill in real values, then:
#   chmod 640 /etc/magnetlookup/env
#   chown root:magnetlookup /etc/magnetlookup/env

# Search-term inputs. MAGNET_SEARCH_FILE_2 is optional — a local path (iCloud/
# Drive sync doesn't apply on a server, so this is less useful here) or an
# s3://bucket/key URI, fetched via the aws CLI using the instance's IAM role
# (needs s3:GetObject on the object — see iam-policy-s3-backup.json). Leave
# blank to disable.
MAGNET_SEARCH_FILE=/opt/magnetlookup/data/search_term.txt
MAGNET_SEARCH_FILE_2=

# URL templates — start from urls.txt.sample shipped alongside this file.
MAGNET_URLS_FILE=/opt/magnetlookup/data/urls.txt

# SQLite library, logs, and HTML/CSV output.
MAGNET_DB_FILE=/opt/magnetlookup/data/magnet_library.db
MAGNET_LOG_DIR=/opt/magnetlookup/data/logs
MAGNET_OUTPUT_DIR=/opt/magnetlookup/data/magnet_results

# webserver.py dashboard port (proxied by nginx — see nginx-magnetlookup.conf).
# Bind to localhost only; nginx is what's actually internet-facing.
MAGNET_PORT=8080

# Scraper tuning (defaults are usually fine).
MAGNET_JS_TIMEOUT=10
MAGNET_JS_PAUSE=2
MAGNET_REQUEST_DELAY=2

# S3 bucket used by backup_to_s3.sh for db/log/output backups.
# Leave unset to disable the backup timer's sync step (it'll just skip it).
MAGNET_S3_BUCKET=
