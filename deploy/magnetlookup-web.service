[Unit]
Description=magnetlookup web dashboard (webserver.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magnetlookup
Group=magnetlookup
WorkingDirectory=/opt/magnetlookup/app
EnvironmentFile=/etc/magnetlookup/env
ExecStart=/opt/magnetlookup/venv/bin/python3 webserver.py --port ${MAGNET_PORT}
Restart=on-failure
RestartSec=5

# webserver.py should only be reachable via the nginx reverse proxy on this
# box (see nginx-magnetlookup.conf) — bind it to localhost via config.ini's
# [server] section or firewall it off if it doesn't support a bind-address
# flag in your version.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/magnetlookup/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
